{
  "manifest_version": 3,
  "name": "Complexity Buddy",
  "version": "1.0.0",
  "description": "A cute floating buddy on LeetCode & NeetCode: hover to peek at your code's time & space complexity, click to pin it. Powered by Groq.",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.groq.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Show / hide complexity widget"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/*",
        "https://leetcode.cn/*",
        "https://neetcode.io/*",
        "https://www.neetcode.io/*"
      ],
      "js": [
        "page-bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://leetcode.com/*",
        "https://leetcode.cn/*",
        "https://neetcode.io/*",
        "https://www.neetcode.io/*"
      ],
      "js": [
        "code-check.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
